{
  "name": "wafx-api",
  "version": "0.0.0",
  "private": true,
  "description": "Wafi X catalog and release API. Cloudflare Workers + D1. Separate from backend/, which owns PC Tweaker licensing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply wafx --local",
    "migrate:remote": "wrangler d1 migrations apply wafx --remote",
    "seed:admin": "node scripts/seed-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts admin",
    "test": "node --test \"test/*.test.ts\"",
    "verify:schema": "node scripts/verify-schema.mjs",
    "check": "npm run typecheck && npm run lint && npm run verify:schema && npm run test"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
