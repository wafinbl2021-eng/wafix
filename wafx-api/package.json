{
  "name": "wafx-api",
  "version": "0.0.0",
  "private": true,
  "description": "Wafi X catalog and release API. Cloudflare Workers + D1. Separate from backend/, which owns PC Tweaker licensing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply wafx --local",
    "migrate:remote": "wrangler d1 migrations apply wafx --remote",
    "seed:admin": "node --experimental-strip-types scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "check": "npm run typecheck && npm run verify:schema"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.9.3",
    "wrangler": "^3.99.0"
  }
}
