{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wafix",
  "version": "1.0.0",
  "identifier": "app.wafix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daltoon X",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost https://api.pwnedpasswords.com https://wafx-api.wafinbl2021.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/wafinbl2021-eng/wafix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4MjJFOEVFMjc0RjFBOTMKUldTVEdrOG43dWdpS011akVEUnlYcUxFakVtWWkrZDlodUJZY3NnS0loWG5xWkZCUnMreE9pcGoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Tune Windows with the changes in plain sight",
    "publisher": "Wafi",
    "copyright": "Copyright © 2026 Wafi. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  }
}
